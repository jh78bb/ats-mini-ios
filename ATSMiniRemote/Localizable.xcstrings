    "Allow Bluetooth in Settings" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 블루투스 허용"
          }
        }
      }
    },
    "Also stops at faint stations and sometimes at noise." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "희미한 방송국에서도 멈추지만 잡음에서 멈추기도 합니다."
          }
        }
      }
    },
    "Amateur radio 10 m. Opens in high solar activity; voice in upper sideband (USB)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 10 m. 태양 활동이 높을 때 열리며 상측파대(USB) 음성."
          }
        }
      }
    },
    "Amateur radio 12 m. Daytime long-distance (DX) when solar activity is good, upper sideband (USB)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 12 m. 태양 활동이 좋을 때 낮 장거리 교신, 상측파대(USB)."
          }
        }
      }
    },
    "Amateur radio 15 m. Daytime long-distance (DX) in upper sideband (USB)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 15 m. 낮 시간대 장거리 교신, 상측파대(USB)."
          }
        }
      }
    },
    "Amateur radio 17 m. Quieter long-distance (DX) band in upper sideband (USB)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 17 m. 비교적 한적한 장거리 교신 대역, 상측파대(USB)."
          }
        }
      }
    },
    "Amateur radio 20 m. The classic long-distance (DX) band in upper sideband (USB), mostly daytime." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 20 m. 상측파대(USB)로 먼 곳과 교신하는 대표 대역, 주로 낮."
          }
        }
      }
    },
    "Amateur radio 30 m. Mostly Morse code and digital modes, lower sideband (LSB)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 30 m. 주로 모스 부호와 디지털 모드, 하측파대(LSB)."
          }
        }
      }
    },
    "Amateur radio 40 m. Voice in lower sideband (LSB), active day and night." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 40 m. 하측파대(LSB) 음성, 낮과 밤 모두 활발합니다."
          }
        }
      }
    },
    "Amateur radio 80 m. Voice in lower sideband (LSB), evening and night nets." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 80 m. 하측파대(LSB) 음성, 저녁과 밤 교신이 많습니다."
          }
        }
      }
    },
    "Amateur radio 160 m. Voice and data in lower sideband (LSB), best at night." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마추어 무선 160 m. 하측파대(LSB) 음성·데이터, 밤에 좋습니다."
          }
        }
      }
    },
    "Amplitude modulation, used by long-, medium- and shortwave broadcasts." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진폭 변조. 장파·중파·단파 방송에 쓰입니다."
          }
        }
      }
    },
    "ATS Mini Remote" : {

    },
    "atsmini.local" : {

    },
    "Automatic gain control keeps the volume steady as signals fade. The attenuator weakens very strong signals to avoid distortion." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGC(자동 이득 조절)는 신호가 약해졌다 강해져도 소리 크기를 일정하게 유지합니다. 감쇠기는 아주 강한 신호를 약하게 해 찌그러짐을 막습니다."
          }
        }
      }
    },
